{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assertion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "enum": [
        "target",
        "authority",
        "architecture",
        "ownership"
      ]
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "layer",
    "subject_ref",
    "status",
    "evidence_refs"
  ]
}