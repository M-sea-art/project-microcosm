{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "approval-required",
        "unspecified"
      ]
    },
    "authority": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "subject_ref",
    "decision",
    "authority",
    "evidence_refs"
  ]
}